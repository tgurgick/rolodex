{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolodex.dev/schemas/activity.json",
  "title": "Activity",
  "description": "An activity or interaction logged in the CRM",
  "type": "object",
  "required": ["id", "type", "subject"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the activity"
    },
    "type": {
      "type": "string",
      "enum": ["call", "email", "meeting", "note", "task", "other"],
      "description": "Type of activity"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Activity subject/title"
    },
    "description": {
      "type": "string",
      "description": "Detailed description or notes"
    },
    "outcome": {
      "type": "string",
      "description": "Result of the activity"
    },
    "contactId": {
      "type": "string",
      "format": "uuid",
      "description": "Associated contact"
    },
    "companyId": {
      "type": "string",
      "format": "uuid",
      "description": "Associated company"
    },
    "dealId": {
      "type": "string",
      "format": "uuid",
      "description": "Associated deal"
    },
    "scheduledAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the activity is scheduled"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the activity was completed"
    },
    "duration": {
      "type": "integer",
      "minimum": 0,
      "description": "Duration in minutes"
    },
    "direction": {
      "type": "string",
      "enum": ["inbound", "outbound"],
      "description": "For calls/emails: direction of communication"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["user", "contact"] },
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" }
        }
      },
      "description": "Participants in the activity"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "mimeType": { "type": "string" },
          "size": { "type": "integer" }
        }
      },
      "description": "File attachments"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "customFields": {
      "type": "object",
      "additionalProperties": true
    },
    "ownerId": {
      "type": "string",
      "format": "uuid",
      "description": "User who owns/performed this activity"
    },
    "status": {
      "type": "string",
      "enum": ["scheduled", "completed", "cancelled"],
      "default": "completed"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdBy": {
      "type": "string",
      "format": "uuid"
    },
    "updatedBy": {
      "type": "string",
      "format": "uuid"
    }
  }
}
