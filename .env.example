# Rolodex Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# =============================================================================
# Database
# =============================================================================
# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rolodex

# Connection pool (optional, defaults in config)
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# =============================================================================
# Cache & Queue
# =============================================================================
# Redis connection string
REDIS_URL=redis://localhost:6379

# =============================================================================
# Authentication
# =============================================================================
# JWT secret key (generate a secure random string for production)
# Use: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# OAuth (if using OAuth providers)
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# =============================================================================
# AI Integration
# =============================================================================
# Anthropic API key (for AI features)
AI_API_KEY=

# AI Provider (anthropic, openai)
AI_PROVIDER=anthropic

# =============================================================================
# Encryption
# =============================================================================
# Field-level encryption key (32 bytes, base64 encoded)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Key Management Service (for production)
# AWS_KMS_KEY_ID=
# GCP_KMS_KEY_NAME=
# AZURE_KEYVAULT_KEY_ID=

# =============================================================================
# Storage
# =============================================================================
# For S3-compatible storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=rolodex-files

# For Google Cloud Storage
# GCS_PROJECT_ID=
# GCS_BUCKET=rolodex-files

# For Azure Blob Storage
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=rolodex-files

# =============================================================================
# Email
# =============================================================================
# SMTP configuration
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# SendGrid
# SENDGRID_API_KEY=

# =============================================================================
# Integrations
# =============================================================================
# Slack
# SLACK_WEBHOOK_URL=
# SLACK_BOT_TOKEN=

# =============================================================================
# Security
# =============================================================================
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# Monitoring (optional)
# =============================================================================
# Sentry
# SENTRY_DSN=

# Datadog
# DD_API_KEY=
# DD_APP_KEY=

# =============================================================================
# Feature Flags
# =============================================================================
# Enable/disable features
FEATURE_AI_ENABLED=true
FEATURE_WORKFLOWS_ENABLED=true
FEATURE_ANALYTICS_ENABLED=true

# =============================================================================
# Development
# =============================================================================
# Enable debug logging
DEBUG=rolodex:*

# Disable TLS verification for local development
# NODE_TLS_REJECT_UNAUTHORIZED=0
