{
  "name": "@rolodex/ai",
  "version": "0.1.0",
  "description": "AI integration and MCP server for Rolodex CRM",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "rolodex-mcp": "./dist/mcp-server.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts && tsup src/mcp-server.ts --format cjs,esm --no-dts",
    "dev": "tsx watch src/mcp-server.ts",
    "start": "node dist/mcp-server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "keywords": ["crm", "ai", "mcp", "claude"],
  "license": "MIT",
  "dependencies": {
    "@rolodex/core": "*",
    "@rolodex/adapters": "*",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
